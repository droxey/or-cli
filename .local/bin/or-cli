#!/usr/bin/env bash
# or-cli — OpenRouter Unified CLI Router
# Routes AI CLI calls (codex, gemini, claude, opencode) through OpenRouter.
# Also dispatches media tasks (image, video, audio, speech, sfx, describe, edit, transcribe)
# via the Nebula media proxy.
#
# Usage:
#   or-cli exec --tool <tool> --tier <tier> --prompt "..."
#   or-cli exec --tool <tool> --model <openrouter/model> --prompt "..."

set -euo pipefail

# ── Text model tiers ──────────────────────────────────────────────────────────
MODEL_CODING="openai/gpt-5.5"
MODEL_REASONING="deepseek/deepseek-r1"
MODEL_FAST="anthropic/claude-haiku-4-6"

# ── Vision model tiers ────────────────────────────────────────────────────────
MODEL_VISION_STANDARD="openai/gpt-5-image"
MODEL_VISION_FAST="google/gemini-2.5-flash-image"
MODEL_VISION_PRO="google/gemini-3-pro-image-preview"

# ── Audio model tiers ─────────────────────────────────────────────────────────
MODEL_AUDIO_SPEECH="nebula:generate_speech"    # Nebula native TTS
MODEL_AUDIO_MUSIC="nebula:generate_audio"      # Nebula native music/sound
MODEL_AUDIO_SFX="nebula:generate_sound_effect" # Nebula native SFX
MODEL_AUDIO_TTS_OR="elevenlabs/eleven-turbo-v2-5" # OpenRouter ElevenLabs

# ── Colors ────────────────────────────────────────────────────────────────────
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
MAGENTA='\033[0;35m'
NC='\033[0m'

die()  { echo -e "${RED}or-cli: $1${NC}" >&2; exit 1; }
info() { echo -e "${CYAN}or-cli: $1${NC}" >&2; }
ok()   { echo -e "${GREEN}or-cli: $1${NC}" >&2; }
warn() { echo -e "${YELLOW}or-cli: $1${NC}" >&2; }

validate_env() {
    [[ -z "${OPENROUTER_API_KEY:-}" ]] && die "OPENROUTER_API_KEY is not set."
}

validate_tool() {
    command -v "$1" &>/dev/null || die "'$1' is not installed or not in PATH."
}

# ── Tier auto-detection (text) ────────────────────────────────────────────────
detect_tier() {
    local lower
    lower=$(echo "$1" | tr '[:upper:]' '[:lower:]')
    if echo "$lower" | grep -qE '\b(plan|analyze|analyz|reason|think|design|architect|debug|investigate|brainstorm|evaluate|assess|compare|tradeoff|optimize|refactor|review|explain why|root cause|deep dive|complex|multi.step|step.by.step)\b'; then
        echo "reasoning"; return
    fi
    if echo "$lower" | grep -qE '\b(summarize|summary|quick|simple|short|brief|tldr|list|format|rename|typo|fix typo|one.liner|small change|tiny|minor)\b'; then
        echo "fast"; return
    fi
    echo "coding"
}

get_model_for_tier() {
    case "$1" in
        reasoning) echo "$MODEL_REASONING" ;;
        fast)      echo "$MODEL_FAST" ;;
        vision)    echo "$MODEL_VISION_STANDARD" ;;
        vision-fast) echo "$MODEL_VISION_FAST" ;;
        vision-pro)  echo "$MODEL_VISION_PRO" ;;
        *)         echo "$MODEL_CODING" ;;
    esac
}

# ── Text CLI runners ──────────────────────────────────────────────────────────
run_codex() {
    local model="$1"; shift
    OPENAI_API_KEY="$OPENROUTER_API_KEY" \
    OPENAI_BASE_URL="http://127.0.0.1:9091/v1" \
    codex exec --skip-git-repo-check --dangerously-bypass-approvals-and-sandbox \
        -m "${model}" "$@"
}

run_gemini() {
    local model="$1"; shift
    GOOGLE_API_KEY="$OPENROUTER_API_KEY" \
    GOOGLE_BASE_URL="http://127.0.0.1:9091/v1" \
    gemini -m "${model}" --skip-trust -p "$@"
}

run_claude() {
    local model="$1"; shift
    ANTHROPIC_API_KEY="$OPENROUTER_API_KEY" \
    ANTHROPIC_BASE_URL="http://127.0.0.1:9091/v1" \
    claude --model "${model}" "$@"
}

run_cline() {
    local model="$1"; shift
    OPENAI_API_KEY="$OPENROUTER_API_KEY" \
    OPENAI_BASE_URL="http://127.0.0.1:9091/v1" \
    cline --model "${model}" "$@"
}

run_opencode() {
    local model="$1"; shift
    OPENCODE_API_KEY="$OPENROUTER_API_KEY" \
    OPENCODE_BASE_URL="http://127.0.0.1:9091/v1" \
    opencode -m "${model}" "$@"
}

# ── Media dispatch via Nebula proxy ───────────────────────────────────────────
# Nebula media tools are exposed via the agent HTTP proxy at $OPENAI_BASE_URL.
# We call them as REST actions.

nebula_media_call() {
    local action="$1"; shift  # e.g. generate_image, generate_video, etc.
    local payload="$1"        # JSON string

    local base_url="${OPENAI_BASE_URL:-https://api.nebula.gg/v1}"
    # Strip trailing /v1 if present to get the base
    base_url="${base_url%/v1}"

    curl -sS -X POST \
        "${base_url}/media/${action}" \
        -H "Authorization: Bearer ${OPENROUTER_API_KEY}" \
        -H "Content-Type: application/json" \
        -d "$payload"
}

run_media_image() {
    local prompt="$1" model="${2:-}" output="${3:-}"
    local payload
    if [[ -n "$model" ]]; then
        payload=$(printf '{"prompt":%s,"model":%s}' \
            "$(echo "$prompt" | python3 -c 'import json,sys; print(json.dumps(sys.stdin.read().strip()))')" \
            "$(echo "$model"  | python3 -c 'import json,sys; print(json.dumps(sys.stdin.read().strip()))')")
    else
        payload=$(printf '{"prompt":%s}' \
            "$(echo "$prompt" | python3 -c 'import json,sys; print(json.dumps(sys.stdin.read().strip()))')")
    fi
    info "Generating image via ${model:-default vision model}..."
    nebula_media_call "generate_image" "$payload"
}

run_media_video() {
    local prompt="$1" model="${2:-}"
    local payload
    payload=$(printf '{"prompt":%s}' \
        "$(echo "$prompt" | python3 -c 'import json,sys; print(json.dumps(sys.stdin.read().strip()))')")
    info "Generating video..."
    nebula_media_call "generate_video" "$payload"
}

run_media_speech() {
    local prompt="$1" voice="${2:-alloy}"
    local payload
    payload=$(printf '{"text":%s,"voice":%s}' \
        "$(echo "$prompt" | python3 -c 'import json,sys; print(json.dumps(sys.stdin.read().strip()))')" \
        "$(echo "$voice"  | python3 -c 'import json,sys; print(json.dumps(sys.stdin.read().strip()))')")
    info "Generating speech (voice: ${voice})..."
    nebula_media_call "generate_speech" "$payload"
}

run_media_audio() {
    local prompt="$1"
    local payload
    payload=$(printf '{"prompt":%s}' \
        "$(echo "$prompt" | python3 -c 'import json,sys; print(json.dumps(sys.stdin.read().strip()))')")
    info "Generating audio/music..."
    nebula_media_call "generate_audio" "$payload"
}

run_media_sfx() {
    local prompt="$1"
    local payload
    payload=$(printf '{"prompt":%s}' \
        "$(echo "$prompt" | python3 -c 'import json,sys; print(json.dumps(sys.stdin.read().strip()))')")
    info "Generating sound effect..."
    nebula_media_call "generate_sound_effect" "$payload"
}

run_media_describe() {
    local source="$1" prompt="${2:-Describe this image in detail.}"
    local payload
    payload=$(printf '{"source":%s,"prompt":%s}' \
        "$(echo "$source" | python3 -c 'import json,sys; print(json.dumps(sys.stdin.read().strip()))')" \
        "$(echo "$prompt" | python3 -c 'import json,sys; print(json.dumps(sys.stdin.read().strip()))')")
    info "Describing image/video..."
    nebula_media_call "describe_image" "$payload"
}

run_media_edit() {
    local source="$1" instruction="$2"
    local payload
    payload=$(printf '{"source":%s,"instruction":%s}' \
        "$(echo "$source"      | python3 -c 'import json,sys; print(json.dumps(sys.stdin.read().strip()))')" \
        "$(echo "$instruction" | python3 -c 'import json,sys; print(json.dumps(sys.stdin.read().strip()))')")
    info "Editing image..."
    nebula_media_call "edit_image" "$payload"
}

run_media_transcribe() {
    local source="$1"
    local payload
    payload=$(printf '{"source":%s}' \
        "$(echo "$source" | python3 -c 'import json,sys; print(json.dumps(sys.stdin.read().strip()))')")
    info "Transcribing audio..."
    nebula_media_call "transcribe_audio" "$payload"
}

# ── Usage ─────────────────────────────────────────────────────────────────────
usage() {
    cat <<'EOF'
or-cli — OpenRouter Unified CLI Router

USAGE
  or-cli exec --tool <tool> [--tier <tier>] [--model <model>] --prompt "..."
  or-cli exec --tool media  --tier <media-tier> [media-options]

TEXT TOOLS
  --tool codex | gemini | claude | cline | opencode

TEXT TIERS (--tier)
  coding        openai/gpt-5.5                  (default)
  reasoning     deepseek/deepseek-r1
  fast          anthropic/claude-haiku-4-6

  Omit --tier to auto-detect from --prompt keywords.
  Use --model to bypass tiers entirely (any OpenRouter model string).

MEDIA TIERS (--tool media --tier <tier>)
  vision        Generate image  (default model: openai/gpt-5-image)
  vision-fast   Generate image  (model: google/gemini-2.5-flash-image)
  vision-pro    Generate image  (model: google/gemini-3-pro-image-preview)
  video         Generate video
  speech        Text-to-speech  (add --voice <name> to pick voice)
  audio         Generate music/ambient audio
  sfx           Generate sound effect
  describe      Describe/OCR an image or video  (requires --source)
  edit          Edit an existing image           (requires --source --instruction)
  transcribe    Transcribe audio to text         (requires --source)

MEDIA OPTIONS
  --prompt <text>        Input prompt or text
  --source <path|url>    Source file for describe/edit/transcribe
  --instruction <text>   Edit instruction (for --tier edit)
  --voice <name>         Voice for speech (alloy, nova, shimmer, onyx, echo, fable, coral, sage)
  --model <openrouter-id> Override vision model (e.g. openai/gpt-5-image-mini)

EXAMPLES
  # Text routing
  or-cli exec --tool codex --prompt "Write fibonacci in Python"
  or-cli exec --tool claude --tier reasoning --prompt "Design a cache invalidation strategy"
  or-cli exec --tool gemini --model "anthropic/claude-sonnet-4-6" --prompt "Summarize this"

  # Image generation (explicit vision tier)
  or-cli exec --tool media --tier vision --prompt "A red fox in a snowy forest"
  or-cli exec --tool media --tier vision-pro --model "openai/gpt-5-image" --prompt "Logo concept"
  or-cli exec --tool media --tier vision-fast --prompt "Quick thumbnail idea"

  # Video generation
  or-cli exec --tool media --tier video --prompt "Time-lapse of a city at night"

  # Speech / audio / sfx
  or-cli exec --tool media --tier speech --prompt "Welcome to the lecture." --voice nova
  or-cli exec --tool media --tier audio --prompt "Lo-fi hip hop beat for studying"
  or-cli exec --tool media --tier sfx --prompt "Short thunder clap, 2 seconds"

  # Describe / edit / transcribe
  or-cli exec --tool media --tier describe --source "@file:images/chart.png" --prompt "Extract all text"
  or-cli exec --tool media --tier edit --source "@file:images/photo.png" --instruction "Make the background white"
  or-cli exec --tool media --tier transcribe --source "@file:audio/recording.mp3"
EOF
}

# ── Main ──────────────────────────────────────────────────────────────────────
main() {
    [[ $# -eq 0 ]] && usage && exit 0

    local subcmd="${1:-}"; shift || true
    [[ "$subcmd" == "--help" || "$subcmd" == "-h" ]] && usage && exit 0
    [[ "$subcmd" != "exec" ]] && die "Unknown subcommand '${subcmd}'. Use 'or-cli exec ...' or 'or-cli --help'."

    local tool="" model="" tier="" prompt="" source="" instruction="" voice="alloy"
    local -a extra_args=()

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --tool)        tool="$2";        shift 2 ;;
            --model)       model="$2";       shift 2 ;;
            --tier)        tier="$2";        shift 2 ;;
            --prompt)      prompt="$2";      shift 2 ;;
            --source)      source="$2";      shift 2 ;;
            --instruction) instruction="$2"; shift 2 ;;
            --voice)       voice="$2";       shift 2 ;;
            --help|-h)     usage; exit 0 ;;
            *)             extra_args+=("$1"); shift ;;
        esac
    done

    [[ -z "$tool" ]] && die "Missing --tool. Run 'or-cli --help' for usage."
    validate_env

    # ── Media dispatch ────────────────────────────────────────────────────────
    if [[ "$tool" == "media" ]]; then
        [[ -z "$tier" ]] && die "Media tool requires --tier. E.g. --tier vision, --tier speech, etc."
        case "$tier" in
            vision|vision-fast|vision-pro)
                [[ -z "$prompt" ]] && die "--tier ${tier} requires --prompt."
                local vis_model="${model:-$(get_model_for_tier "$tier")}"
                run_media_image "$prompt" "$vis_model"
                ;;
            video)
                [[ -z "$prompt" ]] && die "--tier video requires --prompt."
                run_media_video "$prompt" "${model:-}"
                ;;
            speech)
                [[ -z "$prompt" ]] && die "--tier speech requires --prompt."
                run_media_speech "$prompt" "$voice"
                ;;
            audio)
                [[ -z "$prompt" ]] && die "--tier audio requires --prompt."
                run_media_audio "$prompt"
                ;;
            sfx)
                [[ -z "$prompt" ]] && die "--tier sfx requires --prompt."
                run_media_sfx "$prompt"
                ;;
            describe)
                [[ -z "$source" ]] && die "--tier describe requires --source."
                run_media_describe "$source" "${prompt:-Describe this in detail.}"
                ;;
            edit)
                [[ -z "$source" ]]      && die "--tier edit requires --source."
                [[ -z "$instruction" ]] && die "--tier edit requires --instruction."
                run_media_edit "$source" "$instruction"
                ;;
            transcribe)
                [[ -z "$source" ]] && die "--tier transcribe requires --source."
                run_media_transcribe "$source"
                ;;
            *)
                die "Unknown media tier '${tier}'. Run 'or-cli --help' for available tiers."
                ;;
        esac
        return
    fi

    # ── Text CLI dispatch ─────────────────────────────────────────────────────
    validate_tool "$tool"

    if [[ -z "$model" ]]; then
        if [[ -n "$tier" ]]; then
            model=$(get_model_for_tier "$tier")
            info "Tier: ${tier} → ${model}"
        elif [[ -n "$prompt" ]]; then
            tier=$(detect_tier "$prompt")
            model=$(get_model_for_tier "$tier")
            info "Auto-detected: ${tier} → ${model}"
        else
            model="$MODEL_CODING"
            info "Default: coding → ${model}"
        fi
    else
        info "Explicit model: ${model}"
    fi

    local -a cmd_args=()
    [[ -n "$prompt" ]] && cmd_args+=("$prompt")
    cmd_args+=("${extra_args[@]+${extra_args[@]}}")

    case "$tool" in
        codex)    run_codex    "$model" "${cmd_args[@]}" ;;
        gemini)   run_gemini   "$model" "${cmd_args[@]}" ;;
        claude)   run_claude   "$model" "${cmd_args[@]}" ;;
        cline)    run_cline    "$model" "${cmd_args[@]}" ;;
        opencode) run_opencode "$model" "${cmd_args[@]}" ;;
        *)        die "Unknown tool '${tool}'. Valid: codex, gemini, claude, cline, opencode, media" ;;
    esac
}

main "$@"
